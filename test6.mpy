from machine import Pin, I2C
from utime import sleep_ms, ticks_us, ticks_diff,sleep
import ssd1306
import sys

# ---------------- OLED SETUP ----------------
i2c = I2C(0, scl=Pin(22), sda=Pin(21))
oled = ssd1306.SSD1306_I2C(128, 64, i2c)

def oled_print(line1="", line2="", line3="", line4=""):
    oled.fill(0)
    oled.text(line1, 0, 0)
    oled.text(line2, 0, 16)
    oled.text(line3, 0, 32)
    oled.text(line4, 0, 48)
    oled.show()

# ---------------- PIN DEFINITIONS ----------------
outPin = [15, 2, 4, 16, 17, 5, 18, 19, 23]
inPin  = [33, 27, 14, 32, 26, 12, 34, 25, 13]   # order must match expected

# Mapping: output GPIO -> expected input GPIO
expected = {
    15: 33, 2: 27, 4: 14, 16: 32, 17: 26,
    5: 12, 18: 34, 19: 25, 23: 13
}

# Create output pins
opins = [Pin(p, Pin.OUT) for p in outPin]

# Create input pins — NO PULL_DOWN on input-only pins (34+)
ipins = []
for p in inPin:
    if p >= 34:                     # input-only pins: 34,35,36,39
        ipins.append(Pin(p, Pin.IN))          # no pull
    else:
        ipins.append(Pin(p, Pin.IN, Pin.PULL_DOWN))

# Set all outputs low initially
for p in opins:
    p.value(0)

# ---------------- DELAY TEST ----------------
def delay_test(out_gpio, in_gpio, timeout_us=5000):   # increased timeout a bit
    out_gpio.value(0)
    sleep_ms(5)                    # longer settle time

    t_start = ticks_us()
    out_gpio.value(1)

    while not in_gpio.value():
        if ticks_diff(ticks_us(), t_start) > timeout_us:
            return False, 0        # timeout → no signal

    delay = ticks_diff(ticks_us(), t_start)
    out_gpio.value(0)
    return True, delay

# ---------------- SIGNAL TEST ----------------
def signal_integrity_check():
    print("\n=== HARNESS SIGNAL PROPAGATION TEST ===\n")
    oled_print("Harness Test", "Starting...", "", "")
    sleep_ms(1000)

    for i in range(len(opins)):
        out_gpio = opins[i]
        out_num = outPin[i]
        expected_in_num = expected[out_num]

        try:
            in_index = inPin.index(expected_in_num)
        except ValueError:
            print(f"Error: Expected input {expected_in_num} not in inPin list!")
            oled_print("CONFIG ERROR", "", "", "")
            sys.exit()

        in_gpio = ipins[in_index]
        msg = f"{out_num} -> {expected_in_num}"

        print(f"Testing: {msg}")
        oled_print("Testing", msg, "", "")

        success, delay = delay_test(out_gpio, in_gpio)

        if not success:
            print("NO SIGNAL - HARNESS FAIL")
            oled_print("NO SIGNAL", msg, "HARNESS FAIL", "")
            return 0
        else:
            if delay < 100:        # adjust threshold as needed
                print(f"PASS (delay: {delay} us)")
                oled_print("PASS", msg, f"{delay} us", "")
            else:
                print(f"HIGH DELAY WARNING ({delay} us)")
                oled_print("WARNING", msg, f"{delay} us", "")

        sleep_ms(1000)

# ---------------- MAIN ----------------
try:
    signal_integrity_check()
    print("\n======================")
    print("   HARNESS TEST PASS   ")
    print("======================\n")
    oled_print("TEST COMPLETE", "HARNESS PASS", "", "")
except Exception as e:
    print("Test failed with exception:", e)
    oled_print("TEST ERROR", str(e)[:16], "", "")
    sleep(1000)
    